<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
  <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
</head>
<body class="template-password color-scheme-3">
  <div class="password-page">
    <div class="password-page__inner">
      {% if settings.favicon %}
        <img src="{{ settings.favicon | image_url: width: 80 }}" alt="{{ shop.name }}" class="password-page__logo" width="80" height="80" loading="lazy">
      {% endif %}
      <h1 class="password-page__title">{{ shop.name }}</h1>
      <p class="password-page__text">{{ shop.password_message | default: 'Çok yakında sizlerle.' }}</p>

      {{ content_for_layout }}

      {%- if shop.password_message == blank -%}
        {% form 'storefront_password' %}
          {%- if form.errors -%}
            <p class="form__message form__message--error">{{ form.errors.messages['form'] }}</p>
          {%- endif -%}
          <div class="password-page__form-row">
            <input type="password" name="password" placeholder="Şifre" required class="password-page__input">
            <button type="submit" class="button button--primary">Gir</button>
          </div>
        {% endform %}
      {%- endif -%}

      <div class="password-page__social">
        {% render 'social-icons' %}
      </div>
    </div>
  </div>
</body>
</html>
