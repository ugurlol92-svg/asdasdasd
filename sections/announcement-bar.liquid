<div class="announcement-bar color-{{ section.settings.color_scheme }}" {% if section.blocks.size > 1 %}data-announcement-bar data-autoplay="{{ section.settings.autoplay }}" data-speed="{{ section.settings.change_speed | times: 1000 }}"{% endif %}>
  {%- if section.blocks.size > 0 -%}
    <div class="announcement-bar__inner page-width">
      <div class="announcement-bar__track" {% if section.blocks.size > 1 %}id="AnnouncementTrack"{% endif %}>
        {%- for block in section.blocks -%}
          <div class="announcement-bar__item" {{ block.shopify_attributes }} {% if forloop.index0 != 0 %}hidden{% endif %} data-announcement-item>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
            {%- else -%}
              <span>{{ block.settings.text }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Duyuru Çubuğu",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Renk şeması",
      "default": "scheme-3"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Otomatik geçiş",
      "default": true
    },
    {
      "type": "range",
      "id": "change_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "sn",
      "label": "Geçiş süresi",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Duyuru",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Metin",
          "default": "Tüm siparişlerde 500 TL üzeri kargo ücretsiz"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Bağlantı (opsiyonel)"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "announcement", "settings": { "text": "Tüm siparişlerde 500 TL üzeri kargo ücretsiz" } },
      { "type": "announcement", "settings": { "text": "Yeni sezon ürünleri şimdi vitrinde" } },
      { "type": "announcement", "settings": { "text": "%100 orijinal, dermatolojik test edilmiş" } }
    ]
  }
}
{% endschema %}
