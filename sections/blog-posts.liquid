{%- liquid
  assign blog = blogs[section.settings.blog]
-%}
<section class="blog-posts color-{{ section.settings.color_scheme }} section-padding" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="section-heading section-heading--{{ section.settings.heading_alignment }}">
      {%- if section.settings.subheading != blank -%}<p class="section-heading__subtitle">{{ section.settings.subheading }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section-heading__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if blog -%}
        <a href="{{ blog.url }}" class="section-heading__link">Tüm Yazılar {% render 'icon', icon: 'arrow-right' %}</a>
      {%- endif -%}
    </div>
    <div class="blog-posts__grid blog-posts__grid--{{ section.settings.columns_desktop }}-col">
      {%- if blog -%}
        {%- for article in blog.articles limit: section.settings.posts_to_show -%}
          <article class="blog-post-card">
            <a href="{{ article.url }}" class="blog-post-card__media ratio-landscape">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.image.alt | escape }}" loading="lazy">
              {%- else -%}
                {{ 'lifestyle-5' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="blog-post-card__content">
              <p class="blog-post-card__date">{{ article.published_at | date: '%d %B %Y' }}</p>
              <h3 class="blog-post-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
              {%- if section.settings.show_excerpt -%}
                <p class="blog-post-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 110 }}</p>
              {%- endif -%}
              <a href="{{ article.url }}" class="blog-post-card__link">{{ 'blogs.article.read_more' | t }}</a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="blog-post-card">
            <div class="blog-post-card__media ratio-landscape">{{ 'lifestyle-5' | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="blog-post-card__content">
              <h3 class="blog-post-card__title">Blog Yazı Başlığı</h3>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog Yazıları",
  "tag": "section",
  "class": "section-blog-posts",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Üst başlık", "default": "Güzellik Rehberi" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Blogumuzdan Son Yazılar" },
    { "type": "select", "id": "heading_alignment", "label": "Başlık hizası", "options": [
      { "value": "left", "label": "Sol" }, { "value": "center", "label": "Orta" }
    ], "default": "left" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "posts_to_show", "min": 2, "max": 6, "step": 1, "label": "Gösterilecek yazı sayısı", "default": 3 },
    { "type": "select", "id": "columns_desktop", "label": "Sütun sayısı", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ], "default": "3" },
    { "type": "checkbox", "id": "show_excerpt", "label": "Özeti göster", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Blog Yazıları" }
  ]
}
{% endschema %}
