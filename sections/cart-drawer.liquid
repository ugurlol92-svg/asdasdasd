{%- liquid
  assign free_shipping_threshold = settings.cart_free_shipping_threshold | times: 100
  assign cart_percent = cart.total_price | times: 100 | divided_by: free_shipping_threshold | at_most: 100
-%}
<cart-drawer id="CartDrawer" class="cart-drawer color-{{ section.settings.color_scheme }}" data-cart-drawer aria-hidden="true">
  <div class="cart-drawer__overlay" data-cart-drawer-close></div>
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.general.title' | t }}">
    <header class="cart-drawer__header">
      <h2 class="cart-drawer__title">{{ 'cart.general.title' | t }} ({{ cart.item_count }})</h2>
      <button type="button" class="cart-drawer__close" data-cart-drawer-close aria-label="{{ 'general.close' | t }}">
        {% render 'icon', icon: 'close' %}
      </button>
    </header>

    {%- if settings.cart_free_shipping -%}
      <div class="cart-drawer__shipping-bar">
        {%- if cart.total_price >= free_shipping_threshold -%}
          <p class="cart-drawer__shipping-text">{{ 'cart.general.free_shipping_reached' | t }}</p>
        {%- else -%}
          <p class="cart-drawer__shipping-text">{{ 'cart.general.free_shipping_progress_html' | t: amount: free_shipping_threshold | minus: cart.total_price | money }}</p>
        {%- endif -%}
        <div class="cart-drawer__shipping-track">
          <div class="cart-drawer__shipping-fill" style="width: {{ cart_percent }}%"></div>
        </div>
      </div>
    {%- endif -%}

    <div class="cart-drawer__body" id="CartDrawerBody">
      {%- if cart.item_count == 0 -%}
        <div class="cart-drawer__empty">
          <p>{{ 'cart.general.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="button button--primary">{{ 'general.continue_shopping' | t }}</a>
        </div>
      {%- else -%}
        <ul class="cart-drawer__items" id="CartDrawerItems">
          {%- for item in cart.items -%}
            <li class="cart-drawer__item" data-cart-item data-key="{{ item.key }}">
              <a href="{{ item.url }}" class="cart-drawer__item-image">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.image.alt | escape }}" width="100" height="100" loading="lazy">
                {%- endif -%}
              </a>
              <div class="cart-drawer__item-details">
                <a href="{{ item.url }}" class="cart-drawer__item-title">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-drawer__item-variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <div class="cart-drawer__item-price">
                  {%- if item.original_price != item.final_price -%}
                    <s>{{ item.original_price | money }}</s> {{ item.final_price | money }}
                  {%- else -%}
                    {{ item.final_price | money }}
                  {%- endif -%}
                </div>
                <div class="cart-drawer__item-footer">
                  <div class="quantity-input quantity-input--small" data-quantity-input>
                    <button type="button" class="quantity-input__button" data-cart-quantity-decrease data-key="{{ item.key }}" aria-label="{{ 'products.product.quantity.decrease' | t }}">{% render 'icon', icon: 'minus' %}</button>
                    <input type="number" class="quantity-input__field" min="0" value="{{ item.quantity }}" data-cart-quantity-field data-key="{{ item.key }}" aria-label="{{ 'products.product.quantity.label' | t }}">
                    <button type="button" class="quantity-input__button" data-cart-quantity-increase data-key="{{ item.key }}" aria-label="{{ 'products.product.quantity.increase' | t }}">{% render 'icon', icon: 'plus' %}</button>
                  </div>
                  <button type="button" class="cart-drawer__remove" data-cart-remove data-key="{{ item.key }}">{{ 'cart.general.remove' | t }}</button>
                </div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <footer class="cart-drawer__footer">
        {%- if settings.cart_show_note -%}
          <details class="cart-drawer__note">
            <summary>{{ 'cart.general.note' | t }}</summary>
            <textarea name="note" form="CartDrawerForm" data-cart-note placeholder="{{ 'cart.general.note' | t }}">{{ cart.note }}</textarea>
          </details>
        {%- endif -%}
        <div class="cart-drawer__subtotal">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <span id="CartDrawerSubtotal">{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-drawer__shipping-note">{{ 'cart.general.shipping_at_checkout' | t }}</p>
        <a href="{{ routes.cart_url }}" class="button button--secondary button--full">{{ 'cart.general.view_cart' | t }}</a>
        <a href="{{ routes.cart_url }}/checkout" class="button button--primary button--full cart-drawer__checkout">{{ 'cart.general.checkout' | t }}</a>
      </footer>
    {%- endif -%}
  </div>
</cart-drawer>

{% schema %}
{
  "name": "Sepet Paneli",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Renk şeması",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
