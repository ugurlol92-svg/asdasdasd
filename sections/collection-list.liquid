<section class="collection-list color-{{ section.settings.color_scheme }} section-padding" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="section-heading section-heading--{{ section.settings.heading_alignment }}">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>
    <div class="collection-list__grid collection-list__grid--{{ section.settings.columns_desktop }}-col">
      {%- for block in section.blocks -%}
        {%- assign coll = collections[block.settings.collection] -%}
        <a href="{{ coll.url | default: '#' }}" class="collection-card" {{ block.shopify_attributes }}>
          <div class="collection-card__media ratio-square">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 800 }}" srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w" sizes="(min-width: 990px) 25vw, 50vw" alt="{{ coll.title | escape }}" loading="lazy">
            {%- elsif coll.featured_image -%}
              <img src="{{ coll.featured_image | image_url: width: 800 }}" alt="{{ coll.title | escape }}" loading="lazy">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="collection-card__caption">
            <span class="collection-card__title">{{ block.settings.title | default: coll.title }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kategori Listesi",
  "tag": "section",
  "class": "section-collection-list",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Kategorilere Göre Alışveriş" },
    { "type": "select", "id": "heading_alignment", "label": "Başlık hizası", "options": [
      { "value": "left", "label": "Sol" }, { "value": "center", "label": "Orta" }
    ], "default": "center" },
    { "type": "select", "id": "columns_desktop", "label": "Sütun sayısı", "options": [
      { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }, { "value": "6", "label": "6" }
    ], "default": "5" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Kategori",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Koleksiyon" },
        { "type": "image_picker", "id": "image", "label": "Görsel (opsiyonel, koleksiyon görselini geçersiz kılar)" },
        { "type": "text", "id": "title", "label": "Başlık (opsiyonel)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kategori Listesi",
      "blocks": [
        { "type": "collection", "settings": { "title": "Cilt Bakımı" } },
        { "type": "collection", "settings": { "title": "Makyaj" } },
        { "type": "collection", "settings": { "title": "Saç Bakımı" } },
        { "type": "collection", "settings": { "title": "Parfüm" } },
        { "type": "collection", "settings": { "title": "Setler" } }
      ]
    }
  ]
}
{% endschema %}
