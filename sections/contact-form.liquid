<section class="contact-section color-{{ section.settings.color_scheme }} section-padding" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="section-heading section-heading--{{ section.settings.heading_alignment }}">
      {%- if section.settings.subheading != blank -%}<p class="section-heading__subtitle">{{ section.settings.subheading }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h1 class="section-heading__title">{{ section.settings.heading }}</h1>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="section-heading__text">{{ section.settings.text }}</div>{%- endif -%}
    </div>

    <div class="contact-layout">
      <div class="contact-layout__info">
        <ul class="contact-info-list">
          {%- if settings.contact_address != blank -%}
            <li class="contact-info-list__item">
              {% render 'icon', icon: 'location' %}
              <div><strong>Adres</strong><p>{{ settings.contact_address }}</p></div>
            </li>
          {%- endif -%}
          {%- if settings.contact_phone != blank -%}
            <li class="contact-info-list__item">
              {% render 'icon', icon: 'phone' %}
              <div><strong>Telefon</strong><p><a href="tel:{{ settings.contact_phone }}">{{ settings.contact_phone }}</a></p></div>
            </li>
          {%- endif -%}
          {%- if settings.contact_email != blank -%}
            <li class="contact-info-list__item">
              {% render 'icon', icon: 'email' %}
              <div><strong>E-posta</strong><p><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></p></div>
            </li>
          {%- endif -%}
          {%- if settings.contact_hours != blank -%}
            <li class="contact-info-list__item">
              {% render 'icon', icon: 'clock' %}
              <div><strong>Çalışma Saatleri</strong><p>{{ settings.contact_hours }}</p></div>
            </li>
          {%- endif -%}
        </ul>
        {% render 'social-icons' %}

        {%- if section.settings.show_map and settings.contact_address != blank -%}
          <div class="contact-layout__map">
            <iframe
              src="https://maps.google.com/maps?q={{ settings.contact_address | url_encode }}&z=14&output=embed"
              width="100%" height="280" style="border:0;" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
              title="{{ shop.name }} konum haritası">
            </iframe>
          </div>
        {%- endif -%}
      </div>

      <div class="contact-layout__form">
        {% form 'contact', id: 'ContactForm', class: 'contact-form' %}
          {%- if form.posted_successfully? -%}
            <p class="form__message form__message--success">{{ 'templates.contact.form.post_success' | t }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="form__message form__message--error">
              <ul>
                {%- for field in form.errors -%}
                  <li>{% if field == 'form' %}{{ form.errors.messages[field] }}{% else %}{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}{% endif %}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="contact-form__row">
            <label for="ContactFormName">{{ 'templates.contact.form.name' | t }}</label>
            <input type="text" id="ContactFormName" name="contact[name]" value="{{ form.name }}" required>
          </div>
          <div class="contact-form__row">
            <label for="ContactFormEmail">{{ 'templates.contact.form.email' | t }} <span aria-hidden="true">*</span></label>
            <input type="email" id="ContactFormEmail" name="contact[email]" value="{{ form.email }}" spellcheck="false" autocomplete="email" required>
          </div>
          <div class="contact-form__row">
            <label for="ContactFormPhone">{{ 'templates.contact.form.phone' | t }}</label>
            <input type="tel" id="ContactFormPhone" name="contact[phone]" value="{{ form.phone }}">
          </div>
          <div class="contact-form__row">
            <label for="ContactFormMessage">{{ 'templates.contact.form.message' | t }}</label>
            <textarea id="ContactFormMessage" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
          </div>
          <button type="submit" class="button button--primary">{{ 'templates.contact.form.send' | t }}</button>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "İletişim Formu",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Üst başlık", "default": "Bize Ulaşın" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "İletişim" },
    { "type": "select", "id": "heading_alignment", "label": "Başlık hizası", "options": [
      { "value": "left", "label": "Sol" }, { "value": "center", "label": "Orta" }
    ], "default": "center" },
    { "type": "richtext", "id": "text", "label": "Açıklama", "default": "<p>Sorularınız için formu doldurun, size en kısa sürede dönüş yapalım.</p>" },
    { "type": "checkbox", "id": "show_map", "label": "Haritayı göster", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "İletişim Formu" }
  ]
}
{% endschema %}
