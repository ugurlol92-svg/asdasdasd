<section class="countdown-banner color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  {%- if section.settings.background_image != blank -%}
    <div class="countdown-banner__media">
      <img src="{{ section.settings.background_image | image_url: width: 2000 }}" alt="" loading="lazy" class="countdown-banner__image">
      <div class="countdown-banner__overlay"></div>
    </div>
  {%- endif -%}
  <div class="page-width countdown-banner__inner">
    {%- if section.settings.subheading != blank -%}
      <p class="countdown-banner__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="countdown-banner__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.end_date != blank -%}
      <div class="countdown-timer" data-countdown-timer data-end="{{ section.settings.end_date }}">
        <div class="countdown-timer__item"><span class="countdown-timer__value" data-days>00</span><span class="countdown-timer__label">Gün</span></div>
        <div class="countdown-timer__item"><span class="countdown-timer__value" data-hours>00</span><span class="countdown-timer__label">Saat</span></div>
        <div class="countdown-timer__item"><span class="countdown-timer__value" data-minutes>00</span><span class="countdown-timer__label">Dakika</span></div>
        <div class="countdown-timer__item"><span class="countdown-timer__value" data-seconds>00</span><span class="countdown-timer__label">Saniye</span></div>
      </div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="button button--primary">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Geri Sayım Bannerı",
  "tag": "section",
  "class": "section-countdown",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Arka plan görseli" },
    { "type": "text", "id": "subheading", "label": "Üst başlık", "default": "Kaçırılmayacak Fırsat" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Yaz Kampanyasında %30'a Varan İndirim" },
    { "type": "text", "id": "end_date", "label": "Bitiş tarihi ve saati (YYYY-MM-DD HH:MM)", "info": "Örnek: 2026-08-31 23:59", "default": "2026-08-31 23:59" },
    { "type": "text", "id": "button_label", "label": "Buton yazısı", "default": "Kampanyayı İncele" },
    { "type": "url", "id": "button_link", "label": "Buton bağlantısı" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-3" }
  ],
  "presets": [
    { "name": "Geri Sayım Bannerı" }
  ]
}
{% endschema %}
