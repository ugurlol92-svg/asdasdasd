{%- liquid
  assign collection = collections[section.settings.collection]
-%}
<section class="featured-collection color-{{ section.settings.color_scheme }} section-padding" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="section-heading section-heading--{{ section.settings.heading_alignment }}">
      {%- if section.settings.subheading != blank -%}
        <p class="section-heading__subtitle">{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.show_view_all and collection -%}
        <a href="{{ collection.url }}" class="section-heading__link">Tümünü Gör {% render 'icon', icon: 'arrow-right' %}</a>
      {%- endif -%}
    </div>

    <div class="product-grid product-grid--{{ section.settings.columns_desktop }}-col">
      {%- if collection -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', card_product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          {% render 'product-card', card_product: blank %}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and collection -%}
      <div class="featured-collection__view-all-mobile">
        <a href="{{ collection.url }}" class="button button--secondary">Tüm Ürünleri Gör</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Öne Çıkan Koleksiyon",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Üst başlık", "default": "Bayramov Cosmetics" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Çok Satanlar" },
    { "type": "select", "id": "heading_alignment", "label": "Başlık hizası", "options": [
      { "value": "left", "label": "Sol" }, { "value": "center", "label": "Orta" }
    ], "default": "left" },
    { "type": "collection", "id": "collection", "label": "Koleksiyon" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 12, "step": 1, "label": "Gösterilecek ürün sayısı", "default": 8 },
    { "type": "select", "id": "columns_desktop", "label": "Masaüstü sütun sayısı", "options": [
      { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }
    ], "default": "4" },
    { "type": "checkbox", "id": "show_view_all", "label": "\"Tümünü Gör\" bağlantısını göster", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Öne Çıkan Koleksiyon" }
  ]
}
{% endschema %}
