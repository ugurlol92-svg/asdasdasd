<footer class="footer color-{{ section.settings.color_scheme }}">
  <div class="footer__main page-width">
    <div class="footer__grid">
      {%- for block in section.blocks -%}
        <div class="footer__block footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
          {%- case block.type -%}

            {%- when 'brand' -%}
              {%- if block.settings.logo != blank -%}
                <img src="{{ block.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" width="{{ block.settings.logo_width }}" style="max-width:{{ block.settings.logo_width }}px" loading="lazy">
              {%- else -%}
                <p class="footer__logo-text">{{ shop.name }}</p>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="footer__text">{{ block.settings.text }}</div>
              {%- endif -%}
              {% render 'social-icons' %}

            {%- when 'link_list' -%}
              {%- if block.settings.heading != blank -%}<h3 class="footer__heading">{{ block.settings.heading }}</h3>{%- endif -%}
              <ul class="footer__link-list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>

            {%- when 'text' -%}
              {%- if block.settings.heading != blank -%}<h3 class="footer__heading">{{ block.settings.heading }}</h3>{%- endif -%}
              <div class="footer__text">{{ block.settings.text }}</div>

            {%- when 'contact' -%}
              {%- if block.settings.heading != blank -%}<h3 class="footer__heading">{{ block.settings.heading }}</h3>{%- endif -%}
              <ul class="footer__contact-list">
                {%- if settings.contact_address != blank -%}
                  <li>{% render 'icon', icon: 'location' %}<span>{{ settings.contact_address }}</span></li>
                {%- endif -%}
                {%- if settings.contact_phone != blank -%}
                  <li>{% render 'icon', icon: 'phone' %}<a href="tel:{{ settings.contact_phone }}">{{ settings.contact_phone }}</a></li>
                {%- endif -%}
                {%- if settings.contact_email != blank -%}
                  <li>{% render 'icon', icon: 'email' %}<a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>
                {%- endif -%}
              </ul>

            {%- when 'newsletter' -%}
              {%- if block.settings.heading != blank -%}<h3 class="footer__heading">{{ block.settings.heading }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<p class="footer__text">{{ block.settings.text }}</p>{%- endif -%}
              {% form 'customer', id: 'FooterNewsletterForm', class: 'footer__newsletter-form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="footer__newsletter-row">
                  <input type="email" name="contact[email]" placeholder="{{ 'newsletter.label' | t }}" required class="footer__newsletter-input">
                  <button type="submit" class="button button--primary">{% render 'icon', icon: 'arrow-right' %}</button>
                </div>
                {%- if form.posted_successfully? -%}
                  <p class="form__message form__message--success">{{ 'newsletter.success' | t }}</p>
                {%- endif -%}
              {% endform %}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    </div>
  </div>

  <div class="footer__bottom">
    <div class="footer__bottom-inner page-width">
      <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Tüm hakları saklıdır.</p>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payment-icons">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Alt Bilgi",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Renk şeması",
      "default": "scheme-3"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Ödeme ikonlarını göster",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marka / Logo",
      "limit": 1,
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo" },
        { "type": "range", "id": "logo_width", "min": 60, "max": 260, "step": 10, "default": 140, "unit": "px", "label": "Logo genişliği" },
        { "type": "richtext", "id": "text", "label": "Açıklama", "default": "<p>Doğadan ilham alan, cilt dostu kozmetik ürünleri.</p>" }
      ]
    },
    {
      "type": "link_list",
      "name": "Bağlantı Listesi",
      "settings": [
        { "type": "text", "id": "heading", "label": "Başlık", "default": "Kurumsal" },
        { "type": "link_list", "id": "menu", "label": "Menü", "default": "footer" }
      ]
    },
    {
      "type": "contact",
      "name": "İletişim Bilgisi",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Başlık", "default": "İletişim" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Bülten Kaydı",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Başlık", "default": "Fırsatlardan haberdar olun" },
        { "type": "text", "id": "text", "label": "Açıklama", "default": "Yeni ürünler ve kampanyalar için e-posta listemize katılın." }
      ]
    },
    {
      "type": "text",
      "name": "Metin Bloğu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Başlık", "default": "Yardım" },
        { "type": "richtext", "id": "text", "label": "Metin", "default": "<p>Hafta içi 09:00 - 18:00 arası hizmetinizdeyiz.</p>" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "brand" },
      { "type": "link_list", "settings": { "heading": "Kurumsal" } },
      { "type": "contact" },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
