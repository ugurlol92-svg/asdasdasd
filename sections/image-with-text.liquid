<section class="image-with-text color-{{ section.settings.color_scheme }} section-padding" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="image-with-text__grid image-with-text--{{ section.settings.layout }}">
      <div class="image-with-text__media ratio-{{ section.settings.image_ratio }}">
        {%- if section.settings.image != blank -%}
          <img
            src="{{ section.settings.image | image_url: width: 1200 }}"
            srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
            sizes="(min-width: 990px) 50vw, 100vw"
            alt="{{ section.settings.image.alt | escape }}"
            width="{{ section.settings.image.width }}"
            height="{{ section.settings.image.height }}"
            loading="lazy"
          >
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>
      <div class="image-with-text__content">
        {%- if section.settings.subheading != blank -%}
          <p class="image-with-text__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="image-with-text__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="image-with-text__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="button button--primary">{{ section.settings.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Görsel ve Metin",
  "tag": "section",
  "class": "section-image-with-text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Görsel" },
    { "type": "select", "id": "image_ratio", "label": "Görsel oranı", "options": [
      { "value": "square", "label": "Kare" }, { "value": "portrait", "label": "Dikey" }, { "value": "landscape", "label": "Yatay" }
    ], "default": "portrait" },
    { "type": "select", "id": "layout", "label": "Görsel konumu", "options": [
      { "value": "image-left", "label": "Görsel solda" }, { "value": "image-right", "label": "Görsel sağda" }
    ], "default": "image-left" },
    { "type": "text", "id": "subheading", "label": "Üst başlık", "default": "Markamız" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Doğallık ve Etkiyi Buluşturuyoruz" },
    { "type": "richtext", "id": "text", "label": "Metin", "default": "<p>Bayramov Cosmetics olarak, cildinize saygı duyan formüllerle üretilen ürünlerimizi özenle hazırlıyoruz. Her damla, doğanın gücünü bilime taşıyor.</p>" },
    { "type": "text", "id": "button_label", "label": "Buton yazısı", "default": "Hikayemiz" },
    { "type": "url", "id": "button_link", "label": "Buton bağlantısı" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-2" }
  ],
  "presets": [
    { "name": "Görsel ve Metin" }
  ]
}
{% endschema %}
