<section class="instagram-gallery color-{{ section.settings.color_scheme }} section-padding" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="section-heading section-heading--center">
      {%- if section.settings.heading != blank -%}<h2 class="section-heading__title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.handle != blank -%}
        <a href="https://instagram.com/{{ section.settings.handle }}" target="_blank" rel="noopener" class="section-heading__link">@{{ section.settings.handle }}</a>
      {%- endif -%}
    </div>
    <div class="instagram-gallery__grid">
      {%- for block in section.blocks -%}
        <a href="{{ block.settings.link | default: '#' }}" class="instagram-gallery__item" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 500 }}" alt="" loading="lazy">
          {%- else -%}
            {{ 'lifestyle-4' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
          <span class="instagram-gallery__icon">{% render 'icon', icon: 'instagram' %}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Instagram Galerisi",
  "tag": "section",
  "class": "section-instagram",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Bizi Instagram'da Takip Edin" },
    { "type": "text", "id": "handle", "label": "Instagram kullanıcı adı", "default": "bayramovcosmetics" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Görsel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Görsel" },
        { "type": "url", "id": "link", "label": "Bağlantı" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram Galerisi",
      "blocks": [
        { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }, { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
