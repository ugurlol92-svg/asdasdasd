<section class="article-page color-{{ section.settings.color_scheme }} section-padding" data-section-id="{{ section.id }}">
  <div class="page-width page-width--narrow">
    {% render 'breadcrumbs' %}

    <header class="article-page__header">
      <p class="article-page__date">{{ article.published_at | date: '%d %B %Y' }} {% if article.author %}· {{ article.author }}{% endif %}</p>
      <h1 class="article-page__title">{{ article.title }}</h1>
      {%- if article.tags.size > 0 -%}
        <ul class="article-page__tags">
          {%- for tag in article.tags -%}
            <li><a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </header>

    {%- if article.image -%}
      <div class="article-page__image ratio-landscape">
        <img src="{{ article.image | image_url: width: 1600 }}" alt="{{ article.image.alt | escape }}" loading="eager">
      </div>
    {%- endif -%}

    <div class="article-page__content rte">
      {{ article.content }}
    </div>

    <div class="article-page__share">
      <span>{{ 'products.product.share' | t }}:</span>
      {% render 'social-icons' %}
    </div>

    <a href="{{ blog.url }}" class="article-page__back">{% render 'icon', icon: 'chevron-left' %} {{ 'blogs.article.back_to_blog' | t }}</a>

    {%- if blog.comments_enabled? -%}
      <div class="article-page__comments" id="comments">
        <h2>{{ article.comments_count }} {{ 'blogs.article.comments.other' | t: count: article.comments_count }}</h2>

        {%- if article.comments.size > 0 -%}
          <ul class="comment-list">
            {%- for comment in article.comments -%}
              <li class="comment-list__item">
                <p class="comment-list__author">{{ comment.author }} <span>— {{ comment.created_at | date: '%d %B %Y' }}</span></p>
                <div class="comment-list__content">{{ comment.content }}</div>
              </li>
            {%- endfor -%}
          </ul>
          {% render 'pagination', paginate: paginate %}
        {%- endif -%}

        {% form 'new_comment', article, class: 'comment-form' %}
          <h3>{{ 'blogs.article.comment_form_title' | t }}</h3>
          {%- if form.posted_successfully? -%}
            <p class="form__message form__message--success">
              {%- if blog.moderated? -%}{{ 'blogs.article.success' | t }} {{ 'blogs.article.moderated' | t }}{%- else -%}{{ 'blogs.article.success' | t }}{%- endif -%}
            </p>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="form__message form__message--error">
              <ul>
                {%- for field in form.errors -%}
                  <li>{{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
          <div class="comment-form__row">
            <label for="CommentName">{{ 'blogs.article.name' | t }}</label>
            <input type="text" id="CommentName" name="comment[author]" value="{{ form.author }}" required>
          </div>
          <div class="comment-form__row">
            <label for="CommentEmail">{{ 'blogs.article.email' | t }}</label>
            <input type="email" id="CommentEmail" name="comment[email]" value="{{ form.email }}" required>
          </div>
          <div class="comment-form__row">
            <label for="CommentBody">{{ 'blogs.article.message' | t }}</label>
            <textarea id="CommentBody" name="comment[body]" rows="5" required>{{ form.body }}</textarea>
          </div>
          <button type="submit" class="button button--primary">{{ 'blogs.article.post' | t }}</button>
        {% endform %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog Yazısı",
  "tag": "section",
  "class": "section-main-article",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" }
  ]
}
{% endschema %}
