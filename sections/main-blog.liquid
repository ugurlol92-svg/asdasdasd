<section class="blog-page color-{{ section.settings.color_scheme }} section-padding" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="section-heading section-heading--center">
      <h1 class="section-heading__title">{{ blog.title }}</h1>
    </div>

    {%- if blog.tags.size > 0 -%}
      <ul class="blog-page__tags">
        <li><a href="{{ blog.url }}" class="{% unless current_tags %}is-active{% endunless %}">Tümü</a></li>
        {%- for tag in blog.all_tags -%}
          <li><a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="{% if current_tags contains tag %}is-active{% endif %}">{{ tag }}</a></li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- paginate blog.articles by 9 -%}
      <div class="blog-posts__grid blog-posts__grid--3-col">
        {%- for article in blog.articles -%}
          <article class="blog-post-card">
            <a href="{{ article.url }}" class="blog-post-card__media ratio-landscape">
              {%- if article.image -%}
                <img src="{{ article.image | image_url: width: 700 }}" alt="{{ article.image.alt | escape }}" loading="lazy">
              {%- else -%}
                {{ 'lifestyle-5' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="blog-post-card__content">
              <p class="blog-post-card__date">{{ article.published_at | date: '%d %B %Y' }} {% if article.author %}· {{ article.author }}{% endif %}</p>
              <h3 class="blog-post-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
              <p class="blog-post-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 130 }}</p>
              <a href="{{ article.url }}" class="blog-post-card__link">{{ 'blogs.article.read_more' | t }}</a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog Sayfası",
  "tag": "section",
  "class": "section-main-blog",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" }
  ]
}
{% endschema %}
