<section class="collection-banner color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  {%- if section.settings.show_image and collection.image -%}
    <div class="collection-banner__media">
      <img src="{{ collection.image | image_url: width: 2000 }}" alt="{{ collection.title | escape }}" loading="eager">
      <div class="collection-banner__overlay"></div>
    </div>
  {%- endif -%}
  <div class="page-width collection-banner__inner">
    {% render 'breadcrumbs' %}
    <h1 class="collection-banner__title">{{ collection.title }}</h1>
    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="collection-banner__description rte">{{ collection.description }}</div>
    {%- endif -%}
    <p class="collection-banner__count">{{ collection.products_count }} ürün</p>
  </div>
</section>

{% schema %}
{
  "name": "Koleksiyon Başlığı",
  "tag": "section",
  "class": "section-collection-banner",
  "settings": [
    { "type": "checkbox", "id": "show_image", "label": "Koleksiyon görselini göster", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Açıklamayı göster", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-2" }
  ]
}
{% endschema %}
