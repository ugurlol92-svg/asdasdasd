{%- liquid
  assign product = product
  assign current_variant = product.selected_or_first_available_variant
-%}

<section class="product-section color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}
      {% render 'breadcrumbs' %}
    {%- endif -%}

    <div class="product-layout">
      <div class="product-gallery" data-product-gallery>
        {%- if product.media.size > 0 -%}
          <div class="product-gallery__main" data-gallery-main>
            {%- for media in product.media -%}
              <div class="product-gallery__slide {% if forloop.index0 != 0 %}hidden{% endif %}" data-gallery-slide data-media-id="{{ media.id }}" data-index="{{ forloop.index0 }}">
                {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                  <div class="product-gallery__video-wrapper ratio-square">{{ media | media_tag: image_size: '1200x' }}</div>
                {%- elsif media.media_type == 'model' -%}
                  <div class="product-gallery__model ratio-square">{{ media | media_tag }}</div>
                {%- else -%}
                  <img
                    src="{{ media | image_url: width: 1200 }}"
                    srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 1200 }} 1200w"
                    sizes="(min-width: 990px) 50vw, 100vw"
                    alt="{{ media.alt | escape }}"
                    width="{{ media.width }}"
                    height="{{ media.height }}"
                    loading="{% if forloop.index0 == 0 %}eager{% else %}lazy{% endif %}"
                    class="product-gallery__image"
                  >
                {%- endif -%}
              </div>
            {%- endfor -%}
            <button type="button" class="product-gallery__arrow product-gallery__arrow--prev" data-gallery-prev aria-label="{{ 'general.pagination.previous' | t }}">{% render 'icon', icon: 'chevron-left' %}</button>
            <button type="button" class="product-gallery__arrow product-gallery__arrow--next" data-gallery-next aria-label="{{ 'general.pagination.next' | t }}">{% render 'icon', icon: 'chevron-right' %}</button>
          </div>
          {%- if product.media.size > 1 -%}
            <div class="product-gallery__thumbs" data-gallery-thumbs>
              {%- for media in product.media -%}
                <button type="button" class="product-gallery__thumb {% if forloop.index0 == 0 %}is-active{% endif %}" data-gallery-thumb data-index="{{ forloop.index0 }}" aria-label="{{ 'products.product.media.open_media' | t }}">
                  <img src="{{ media.preview_image | image_url: width: 200 }}" alt="" loading="lazy" width="70" height="70">
                  {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                    <span class="product-gallery__thumb-icon">{% render 'icon', icon: 'play' %}</span>
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- else -%}
          <div class="product-gallery__main">
            <div class="product-gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
          </div>
        {%- endif -%}
      </div>

      <div class="product-info" data-product-info>
        <product-info data-product-info-root data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}" data-url="{{ product.url }}">
          <script type="application/json" data-product-json>{{ product.variants | json }}</script>

          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when 'title' -%}
                <div class="product-info__title-block" {{ block.shopify_attributes }}>
                  {%- if block.settings.show_vendor and product.vendor != blank -%}
                    <p class="product-info__vendor">{{ product.vendor }}</p>
                  {%- endif -%}
                  <h1 class="product-info__title">{{ product.title }}</h1>
                  {%- if product.metafields.reviews.rating.value -%}
                    <div class="product-info__rating" aria-hidden="true">
                      {%- assign rating = product.metafields.reviews.rating.value.rating -%}
                      {%- for i in (1..5) -%}{% render 'icon', icon: 'star', class: 'rating-star' | append: ' ' | append: rating | ceil %}{%- endfor -%}
                      <span class="product-info__rating-count">({{ product.metafields.reviews.rating_count.value }})</span>
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'price' -%}
                <div data-product-price {{ block.shopify_attributes }}>
                  {% render 'price', product: product, use_variant: current_variant, show_badge: true %}
                </div>
                {%- if settings.cart_show_note == true -%}
                  <p class="product-info__tax-note">{{ 'cart.general.shipping_at_checkout' | t }}</p>
                {%- endif -%}

              {%- when 'variant_picker' -%}
                <div class="product-info__variants" data-variant-picker {{ block.shopify_attributes }}>
                  {%- for option in product.options_with_values -%}
                    <div class="product-form__option" data-option-index="{{ forloop.index0 }}">
                      <label class="product-form__option-label">{{ option.name }}: <span data-selected-option-value>{{ option.selected_value }}</span></label>
                      {%- if option.name == 'Renk' or option.name == 'Color' -%}
                        <div class="product-form__swatches">
                          {%- for value in option.values -%}
                            <button
                              type="button"
                              class="swatch {% if value == option.selected_value %}is-active{% endif %}"
                              data-option-value="{{ value | escape }}"
                              data-option-index="{{ forloop.parentloop.index0 }}"
                              style="--swatch-color: {{ value | handle }};"
                              aria-label="{{ value }}"
                            >{{ value }}</button>
                          {%- endfor -%}
                        </div>
                      {%- else -%}
                        <div class="product-form__pills">
                          {%- for value in option.values -%}
                            <button
                              type="button"
                              class="pill {% if value == option.selected_value %}is-active{% endif %}"
                              data-option-value="{{ value | escape }}"
                              data-option-index="{{ forloop.parentloop.index0 }}"
                            >{{ value }}</button>
                          {%- endfor -%}
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>

              {%- when 'quantity_selector' -%}
                <div class="product-form__quantity" {{ block.shopify_attributes }}>
                  <label class="product-form__option-label" for="Quantity-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label>
                  {% render 'quantity-input', id_suffix: section.id %}
                </div>

              {%- when 'buy_buttons' -%}
                <div class="product-form__buy-buttons" {{ block.shopify_attributes }}>
                  {% form 'product', product, id: 'ProductForm', class: 'product-form' %}
                    <input type="hidden" name="id" value="{{ current_variant.id }}" data-selected-variant-id>
                    <button
                      type="submit"
                      name="add"
                      class="button button--primary button--full product-form__submit"
                      data-add-to-cart
                      {% unless current_variant.available %}disabled{% endunless %}
                    >
                      <span data-add-to-cart-text>
                        {%- if current_variant.available == false -%}{{ 'products.product.sold_out' | t }}{%- else -%}{{ 'products.product.add_to_cart' | t }}{%- endif -%}
                      </span>
                      <span class="loading-spinner" data-add-to-cart-spinner hidden></span>
                    </button>
                    {%- if block.settings.show_dynamic_checkout -%}
                      {{ form | payment_button }}
                    {%- endif -%}
                  {% endform %}
                </div>

              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="product-info__description rte" {{ block.shopify_attributes }}>
                    {{ product.description }}
                  </div>
                {%- endif -%}

              {%- when 'accordion' -%}
                <details class="product-accordion" {{ block.shopify_attributes }} {% if block.settings.open_by_default %}open{% endif %}>
                  <summary class="product-accordion__summary">
                    {{ block.settings.heading }}
                    {% render 'icon', icon: 'chevron-down', class: 'product-accordion__icon' %}
                  </summary>
                  <div class="product-accordion__content rte">{{ block.settings.content }}</div>
                </details>

              {%- when 'share' -%}
                <div class="product-info__share" {{ block.shopify_attributes }}>
                  <span>{{ 'products.product.share' | t }}:</span>
                  {% render 'social-icons' %}
                </div>

              {%- when 'custom_liquid' -%}
                <div {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>

            {%- endcase -%}
          {%- endfor -%}
        </product-info>
      </div>
    </div>

    {%- if product != blank -%}
      {%- assign json_ld_price = current_variant.price | money_without_currency -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org/",
          "@type": "Product",
          "name": {{ product.title | json }},
          "image": [{{ product.featured_image | image_url: width: 800 | prepend: "https:" | json }}],
          "description": {{ product.description | strip_html | json }},
          "sku": {{ current_variant.sku | json }},
          "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
          "offers": {
            "@type": "Offer",
            "url": {{ product.url | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "price": {{ json_ld_price | json }},
            "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}"
          }
        }
      </script>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Ürün Sayfası",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Breadcrumb göster", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" }
  ],
  "blocks": [
    { "type": "title", "name": "Başlık", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_vendor", "label": "Marka adını göster", "default": true }
    ] },
    { "type": "price", "name": "Fiyat", "limit": 1, "settings": [] },
    { "type": "variant_picker", "name": "Varyant Seçici", "limit": 1, "settings": [] },
    { "type": "quantity_selector", "name": "Adet Seçici", "limit": 1, "settings": [] },
    { "type": "buy_buttons", "name": "Satın Alma Butonları", "limit": 1, "settings": [
      { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Hızlı ödeme butonlarını göster", "default": true }
    ] },
    { "type": "description", "name": "Açıklama", "limit": 1, "settings": [] },
    { "type": "accordion", "name": "Akordeon Bölümü", "settings": [
      { "type": "text", "id": "heading", "label": "Başlık", "default": "Kullanım Şekli" },
      { "type": "richtext", "id": "content", "label": "İçerik", "default": "<p>Temiz cilde uygulayın ve nazikçe masaj yapın.</p>" },
      { "type": "checkbox", "id": "open_by_default", "label": "Varsayılan olarak açık", "default": false }
    ] },
    { "type": "share", "name": "Paylaş", "limit": 1, "settings": [] },
    { "type": "custom_liquid", "name": "Özel Liquid", "settings": [
      { "type": "liquid", "id": "custom_liquid", "label": "Liquid kodu" }
    ] }
  ],
  "default": {
    "blocks": [
      { "type": "title" },
      { "type": "price" },
      { "type": "variant_picker" },
      { "type": "quantity_selector" },
      { "type": "buy_buttons" },
      { "type": "description" },
      { "type": "accordion", "settings": { "heading": "Kullanım Şekli" } },
      { "type": "accordion", "settings": { "heading": "İçindekiler" } },
      { "type": "accordion", "settings": { "heading": "Kargo ve İade" } },
      { "type": "share" }
    ]
  }
}
{% endschema %}
