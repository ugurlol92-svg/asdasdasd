<section class="search-page color-{{ section.settings.color_scheme }} section-padding" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="search-page__header">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
        <input type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" value="{{ search.terms | escape }}" aria-label="{{ 'general.search.placeholder' | t }}">
        <input type="hidden" name="type" value="product">
        <button type="submit">{% render 'icon', icon: 'search' %}</button>
      </form>
      {%- if search.performed -%}
        <h1 class="search-page__title">
          {%- if search.results_count > 0 -%}
            {{ 'general.search.results_for_html' | t: terms: search.terms, count: search.results_count }}
          {%- else -%}
            {{ 'general.search.no_results_html' | t: terms: search.terms }}
          {%- endif -%}
        </h1>
      {%- endif -%}
    </div>

    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        {%- paginate search.results by 24 -%}
          <div class="product-grid product-grid--4-col">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', card_product: item %}
              {%- else -%}
                <a href="{{ item.url }}" class="search-result-card">
                  {%- if item.object_type == 'article' and item.image -%}
                    <img src="{{ item.image | image_url: width: 400 }}" alt="" loading="lazy">
                  {%- endif -%}
                  <h3>{{ item.title }}</h3>
                  <p>{{ item.content | strip_html | truncate: 100 }}</p>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {% render 'pagination', paginate: paginate %}
        {%- endpaginate -%}
      {%- else -%}
        <div class="search-page__empty">
          <a href="{{ routes.all_products_collection_url }}" class="button button--secondary">{{ 'general.continue_shopping' | t }}</a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Arama Sayfası",
  "tag": "section",
  "class": "section-main-search",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" }
  ]
}
{% endschema %}
