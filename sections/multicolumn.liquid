<section class="multicolumn color-{{ section.settings.color_scheme }} section-padding" data-section-id="{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading section-heading--{{ section.settings.heading_alignment }}">
        <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}
    <div class="multicolumn__grid multicolumn__grid--{{ section.settings.columns_desktop }}-col">
      {%- for block in section.blocks -%}
        <div class="multicolumn__item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <div class="multicolumn__icon">{% render 'icon', icon: block.settings.icon %}</div>
          {%- elsif block.settings.image != blank -%}
            <div class="multicolumn__icon multicolumn__icon--image">
              <img src="{{ block.settings.image | image_url: width: 120 }}" alt="" width="48" height="48" loading="lazy">
            </div>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h3 class="multicolumn__item-heading">{{ block.settings.heading }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="multicolumn__item-text">{{ block.settings.text }}</div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Özellik Şeridi",
  "tag": "section",
  "class": "section-multicolumn",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık" },
    { "type": "select", "id": "heading_alignment", "label": "Başlık hizası", "options": [
      { "value": "left", "label": "Sol" }, { "value": "center", "label": "Orta" }
    ], "default": "center" },
    { "type": "select", "id": "columns_desktop", "label": "Sütun sayısı", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }
    ], "default": "4" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Özellik",
      "settings": [
        { "type": "select", "id": "icon", "label": "İkon", "options": [
          { "value": "", "label": "Yok" },
          { "value": "truck", "label": "Kargo" },
          { "value": "shield", "label": "Güvenlik" },
          { "value": "gift", "label": "Hediye" },
          { "value": "leaf", "label": "Doğal" },
          { "value": "heart", "label": "Kalp" },
          { "value": "check", "label": "Onay" }
        ], "default": "truck" },
        { "type": "image_picker", "id": "image", "label": "Görsel (ikon yerine)" },
        { "type": "text", "id": "heading", "label": "Başlık", "default": "Ücretsiz Kargo" },
        { "type": "richtext", "id": "text", "label": "Açıklama", "default": "<p>500 TL üzeri siparişlerde</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Özellik Şeridi",
      "blocks": [
        { "type": "item", "settings": { "icon": "truck", "heading": "Ücretsiz Kargo", "text": "<p>500 TL üzeri siparişlerde</p>" } },
        { "type": "item", "settings": { "icon": "shield", "heading": "Güvenli Ödeme", "text": "<p>256-bit SSL koruması</p>" } },
        { "type": "item", "settings": { "icon": "leaf", "heading": "%100 Doğal İçerik", "text": "<p>Dermatolojik test edilmiştir</p>" } },
        { "type": "item", "settings": { "icon": "gift", "heading": "Kolay İade", "text": "<p>14 gün içinde ücretsiz iade</p>" } }
      ]
    }
  ]
}
{% endschema %}
