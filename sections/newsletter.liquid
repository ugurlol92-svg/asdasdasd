<section class="newsletter-section color-{{ section.settings.color_scheme }}" data-section-id="{{ section.id }}">
  {%- if section.settings.image != blank -%}
    <div class="newsletter-section__media">
      <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="" loading="lazy">
      <div class="newsletter-section__overlay"></div>
    </div>
  {%- endif -%}
  <div class="page-width newsletter-section__inner">
    {%- if section.settings.subheading != blank -%}<p class="newsletter-section__subheading">{{ section.settings.subheading }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="newsletter-section__heading">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="newsletter-section__text">{{ section.settings.text }}</div>{%- endif -%}

    {% form 'customer', id: 'NewsletterFormSection' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-section__form-row">
        <input type="email" name="contact[email]" placeholder="{{ 'newsletter.label' | t }}" required class="newsletter-section__input">
        <button type="submit" class="button button--primary">{{ 'newsletter.button_label' | t }}</button>
      </div>
      {%- if form.posted_successfully? -%}
        <p class="form__message form__message--success">{{ 'newsletter.success' | t }}</p>
      {%- elsif form.errors -%}
        <p class="form__message form__message--error">{{ form.errors.messages['form'] }}</p>
      {%- endif -%}
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Bülten Kaydı",
  "tag": "section",
  "class": "section-newsletter",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Arka plan görseli" },
    { "type": "text", "id": "subheading", "label": "Üst başlık", "default": "Bültenimize Katılın" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "İlk Siparişinizde %10 İndirim Kazanın" },
    { "type": "richtext", "id": "text", "label": "Metin", "default": "<p>Yeni ürünler, kampanyalar ve bakım önerilerinden ilk siz haberdar olun.</p>" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-3" }
  ],
  "presets": [
    { "name": "Bülten Kaydı" }
  ]
}
{% endschema %}
