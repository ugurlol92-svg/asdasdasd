<section class="related-products color-{{ section.settings.color_scheme }} section-padding" data-section-id="{{ section.id }}" data-product-recommendations data-product-id="{{ product.id }}" data-limit="{{ section.settings.products_to_show }}" data-url="{{ routes.product_recommendations_url }}">
  <div class="page-width">
    <div class="section-heading section-heading--{{ section.settings.heading_alignment }}">
      {%- if section.settings.heading != blank -%}<h2 class="section-heading__title">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="product-grid product-grid--{{ section.settings.columns_desktop }}-col" id="RelatedProductsGrid">
      {%- comment -%} Server-rendered fallback: other items from the same collection. JS replaces this with real Product Recommendations API results when available. {%- endcomment -%}
      {%- assign fallback_collection = product.collections.first -%}
      {%- if fallback_collection -%}
        {%- for rec in fallback_collection.products limit: section.settings.products_to_show -%}
          {%- unless rec.id == product.id -%}
            {% render 'product-card', card_product: rec %}
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Benzer Ürünler",
  "tag": "section",
  "class": "section-related-products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Bunları da Beğenebilirsiniz" },
    { "type": "select", "id": "heading_alignment", "label": "Başlık hizası", "options": [
      { "value": "left", "label": "Sol" }, { "value": "center", "label": "Orta" }
    ], "default": "center" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Gösterilecek ürün sayısı", "default": 4 },
    { "type": "select", "id": "columns_desktop", "label": "Sütun sayısı", "options": [
      { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ], "default": "4" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-2" }
  ],
  "presets": [
    { "name": "Benzer Ürünler" }
  ]
}
{% endschema %}
