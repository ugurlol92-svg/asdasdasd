<section class="testimonials color-{{ section.settings.color_scheme }} section-padding" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="section-heading section-heading--center">
      {%- if section.settings.subheading != blank -%}<p class="section-heading__subtitle">{{ section.settings.subheading }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section-heading__title">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="testimonials__grid">
      {%- for block in section.blocks -%}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          {% render 'icon', icon: 'quote', class: 'testimonial-card__quote-icon' }}
          {%- if block.settings.rating > 0 -%}
            <div class="testimonial-card__rating" aria-hidden="true">
              {%- for i in (1..5) -%}
                {% render 'icon', icon: 'star', class: 'rating-star' | append: ' ' | append: block.settings.rating %}
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="testimonial-card__text">{{ block.settings.text }}</p>
          {%- endif -%}
          <div class="testimonial-card__author">
            {%- if block.settings.avatar != blank -%}
              <img src="{{ block.settings.avatar | image_url: width: 80 }}" alt="" class="testimonial-card__avatar" width="40" height="40" loading="lazy">
            {%- endif -%}
            <span class="testimonial-card__name">{{ block.settings.name }}</span>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Müşteri Yorumları",
  "tag": "section",
  "class": "section-testimonials",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Üst başlık", "default": "Müşterilerimiz Ne Diyor" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Binlerce Mutlu Müşteri" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-2" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Yorum",
      "settings": [
        { "type": "range", "id": "rating", "min": 0, "max": 5, "step": 1, "label": "Puan", "default": 5 },
        { "type": "textarea", "id": "text", "label": "Yorum metni", "default": "Cildim çok daha canlı ve nemli görünüyor. Kesinlikle tavsiye ederim!" },
        { "type": "text", "id": "name", "label": "İsim", "default": "Elif Y." },
        { "type": "image_picker", "id": "avatar", "label": "Fotoğraf" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Müşteri Yorumları",
      "blocks": [
        { "type": "testimonial", "settings": { "name": "Elif Y.", "text": "Cildim çok daha canlı ve nemli görünüyor. Kesinlikle tavsiye ederim!" } },
        { "type": "testimonial", "settings": { "name": "Merve K.", "text": "Doğal içerikleri ve hızlı kargosu ile favorim oldu." } },
        { "type": "testimonial", "settings": { "name": "Zeynep A.", "text": "Ambalajı ve kokusu harika, tekrar sipariş vereceğim." } }
      ]
    }
  ]
}
{% endschema %}
