<section class="video-section color-{{ section.settings.color_scheme }} section-padding" data-section-id="{{ section.id }}">
  <div class="page-width">
    <div class="section-heading section-heading--center">
      {%- if section.settings.subheading != blank -%}<p class="section-heading__subtitle">{{ section.settings.subheading }}</p>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="section-heading__title">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    <div class="video-section__wrapper ratio-{{ section.settings.ratio }}">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: image_size: '1920x', autoplay: false, loop: false, controls: true, muted: false, class: 'video-section__video' }}
      {%- elsif section.settings.video_url != blank -%}
        <div class="video-section__embed" data-video-embed data-video-url="{{ section.settings.video_url }}">
          {%- if section.settings.cover_image != blank -%}
            <img src="{{ section.settings.cover_image | image_url: width: 1600 }}" alt="" class="video-section__cover" loading="lazy">
          {%- endif -%}
          <button type="button" class="video-section__play" data-video-play aria-label="{{ 'products.product.media.play_video' | t }}">
            {% render 'icon', icon: 'play' %}
          </button>
        </div>
      {%- else -%}
        {{ 'lifestyle-3' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video Bölümü",
  "tag": "section",
  "class": "section-video",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Üst başlık" },
    { "type": "text", "id": "heading", "label": "Başlık", "default": "Kullanım Videomuzu İzleyin" },
    { "type": "select", "id": "ratio", "label": "Görüntü oranı", "options": [
      { "value": "landscape", "label": "Yatay (16:9)" }, { "value": "square", "label": "Kare" }
    ], "default": "landscape" },
    { "type": "video", "id": "video", "label": "Shopify video (yükleme)" },
    { "type": "text", "id": "video_url", "label": "Youtube / Vimeo bağlantısı", "info": "Yalnızca yukarıda video yüklenmemişse kullanılır" },
    { "type": "image_picker", "id": "cover_image", "label": "Kapak görseli (harici video için)" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Renk şeması", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Video Bölümü" }
  ]
}
{% endschema %}
