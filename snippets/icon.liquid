{%- comment -%}
  Renders an inline SVG icon.
  Usage: {% render 'icon', icon: 'cart' %}
{%- endcomment -%}
{%- liquid
  assign icon_class = 'icon icon-' | append: icon
  if class
    assign icon_class = icon_class | append: ' ' | append: class
  endif
-%}
{%- case icon -%}
  {%- when 'cart' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M3 4h2l2.2 11.4a2 2 0 0 0 2 1.6h7.6a2 2 0 0 0 2-1.6L20.5 8H6"/><circle cx="9.5" cy="20.5" r="1.3"/><circle cx="17.5" cy="20.5" r="1.3"/></svg>
  {%- when 'search' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><line x1="20" y1="20" x2="15.3" y2="15.3"/></svg>
  {%- when 'account' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 20c1.4-3.8 4.3-6 7.5-6s6.1 2.2 7.5 6"/></svg>
  {%- when 'close' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><line x1="5" y1="5" x2="19" y2="19"/><line x1="19" y1="5" x2="5" y2="19"/></svg>
  {%- when 'menu' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
  {%- when 'chevron-down' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><polyline points="5,9 12,16 19,9"/></svg>
  {%- when 'chevron-left' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><polyline points="15,5 8,12 15,19"/></svg>
  {%- when 'chevron-right' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><polyline points="9,5 16,12 9,19"/></svg>
  {%- when 'plus' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><line x1="12" y1="4" x2="12" y2="20"/><line x1="4" y1="12" x2="20" y2="12"/></svg>
  {%- when 'minus' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><line x1="4" y1="12" x2="20" y2="12"/></svg>
  {%- when 'star' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="12,2 15,9 22,9.5 16.5,14 18.5,21 12,17 5.5,21 7.5,14 2,9.5 9,9"/></svg>
  {%- when 'check' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><polyline points="4,13 9,18 20,6"/></svg>
  {%- when 'truck' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="1.5" y="7" width="12.5" height="9"/><path d="M14 10h4l4 3.5V16h-8z"/><circle cx="6" cy="18.5" r="1.6"/><circle cx="17.5" cy="18.5" r="1.6"/></svg>
  {%- when 'shield' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 2.5 20 6v6c0 5-3.4 8.5-8 9.5-4.6-1-8-4.5-8-9.5V6z"/><polyline points="8.5,12 11,14.5 16,9"/></svg>
  {%- when 'gift' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="9" width="18" height="4"/><rect x="5" y="13" width="14" height="8"/><line x1="12" y1="9" x2="12" y2="21"/><path d="M12 9C10 4 5 5 6 8c1 1.8 3.6 1 6 1z"/><path d="M12 9c2-5 7-4 6-1-1 1.8-3.6 1-6 1z"/></svg>
  {%- when 'leaf' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M20 4C10 4 4 10 4 18c9 0 15-6 16-14z"/><path d="M6 18c3-4 6-7 12-12"/></svg>
  {%- when 'heart' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 20s-7.5-4.8-9.8-9.4C.6 6.8 3 3.5 6.5 3.5c2 0 3.6 1 5.5 3 1.9-2 3.5-3 5.5-3 3.5 0 5.9 3.3 4.3 7.1C19.5 15.2 12 20 12 20z"/></svg>
  {%- when 'play' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><polygon points="6,4 20,12 6,20"/></svg>
  {%- when 'arrow-right' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><line x1="4" y1="12" x2="20" y2="12"/><polyline points="13,5 20,12 13,19"/></svg>
  {%- when 'email' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="1.5"/><polyline points="3,6 12,13 21,6"/></svg>
  {%- when 'phone' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 3.5h3.5L10 8l-2 1.5c1 2.5 3 4.5 5.5 5.5L15 13l4.5 1.5V18a2 2 0 0 1-2.2 2C10.5 19.4 4.6 13.5 3 6.7A2 2 0 0 1 5 3.5z"/></svg>
  {%- when 'location' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 21s7-6.6 7-12A7 7 0 0 0 5 9c0 5.4 7 12 7 12z"/><circle cx="12" cy="9" r="2.4"/></svg>
  {%- when 'clock' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="12,7 12,12 16,14.5"/></svg>
  {%- when 'instagram' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.3" cy="6.7" r="1"/></svg>
  {%- when 'facebook' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M14 21v-7.5h2.5l.5-3H14V8.3c0-.9.3-1.5 1.6-1.5H17V4.2C16.7 4.1 15.8 4 14.7 4c-2.3 0-3.9 1.4-3.9 4v2.5H8.3v3H10.8V21z"/></svg>
  {%- when 'tiktok' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M14 3v10.7a3.3 3.3 0 1 1-3.3-3.3c.3 0 .6 0 .9.1"/><path d="M14 3c.4 2.6 2.1 4.4 4.7 4.7"/></svg>
  {%- when 'youtube' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><rect x="2.5" y="6" width="19" height="12" rx="3"/><polygon points="10.5,9.5 15.5,12 10.5,14.5" fill="currentColor" stroke="none"/></svg>
  {%- when 'pinterest' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 19c1-3 1.8-6 2.3-8.2a2.3 2.3 0 0 1 4.5.6c0 2-1.2 4.6-3 4.6-1 0-1.6-.6-1.5-1.6"/></svg>
  {%- when 'twitter' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M20 5.5c-.7.3-1.4.5-2.2.6a3.8 3.8 0 0 0 1.7-2.1c-.8.5-1.6.8-2.5 1a3.8 3.8 0 0 0-6.5 3.5A10.8 10.8 0 0 1 3 4.6a3.8 3.8 0 0 0 1.2 5.1c-.6 0-1.2-.2-1.7-.5v.1c0 1.9 1.3 3.4 3.1 3.8-.6.1-1.1.2-1.7.1.5 1.5 1.9 2.6 3.6 2.7A7.6 7.6 0 0 1 2 17.4a10.8 10.8 0 0 0 5.8 1.7c7 0 10.8-5.8 10.8-10.8v-.5c.8-.5 1.4-1.2 1.9-1.9z"/></svg>
  {%- when 'quote' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9.5 6C6.5 7 4.5 9.7 4.5 13c0 2.5 1.6 4 3.5 4 1.7 0 3-1.3 3-3s-1.2-2.8-2.7-2.8c-.3 0-.6 0-.8.1.4-1.8 1.8-3.3 3.5-3.9L9.5 6zm9 0c-3 1-5 3.7-5 7 0 2.5 1.6 4 3.5 4 1.7 0 3-1.3 3-3s-1.2-2.8-2.7-2.8c-.3 0-.6 0-.8.1.4-1.8 1.8-3.3 3.5-3.9L18.5 6z"/></svg>
  {%- when 'filter' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="7" y1="12" x2="17" y2="12"/><line x1="10" y1="18" x2="14" y2="18"/></svg>
{%- endcase -%}
