{%- comment -%}
  Renders a price block for a product or variant.
  Accepts: product, use_variant (variant object, optional), show_badge (bool)
{%- endcomment -%}
{%- liquid
  if use_variant
    assign target = use_variant
  else
    assign target = product
  endif

  assign compare_at_price = target.compare_at_price
  assign price = target.price
  assign available = target.available | default: product.available

  if compare_at_price > price
    assign on_sale = true
  else
    assign on_sale = false
  endif
-%}
<div class="price {% if on_sale %}price--on-sale{% endif %} {% unless available %}price--sold-out{% endunless %}">
  {%- if available == false -%}
    <span class="price__badge price__badge--sold-out">{{ 'products.product.sold_out' | t }}</span>
  {%- endif -%}
  <span class="price__container">
    {%- if on_sale -%}
      <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
      <s class="price__compare-at">{{ compare_at_price | money }}</s>
      <span class="price__sale">{{ price | money }}</span>
      {%- if show_badge -%}
        {%- assign discount = compare_at_price | minus: price | times: 100.0 | divided_by: compare_at_price | round -%}
        <span class="price__badge price__badge--sale">-%{{ discount }}</span>
      {%- endif -%}
    {%- else -%}
      <span class="price__regular">{{ price | money }}</span>
    {%- endif -%}
  </span>
  {%- if target.unit_price_measurement -%}
    <span class="price__unit">
      ({{ target.unit_price | money }}/{% if target.unit_price_measurement.reference_value != 1 %}{{ target.unit_price_measurement.reference_value }}{% endif %}{{ target.unit_price_measurement.reference_unit }})
    </span>
  {%- endif -%}
</div>
