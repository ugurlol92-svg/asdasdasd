{%- comment -%}
  Accepts: id_suffix, quantity (default value)
{%- endcomment -%}
<div class="quantity-input" data-quantity-input>
  <button type="button" class="quantity-input__button" data-quantity-decrease aria-label="{{ 'products.product.quantity.decrease' | t }}">
    {% render 'icon', icon: 'minus' %}
  </button>
  <input
    type="number"
    name="quantity"
    id="Quantity-{{ id_suffix }}"
    class="quantity-input__field"
    min="1"
    value="{{ quantity | default: 1 }}"
    inputmode="numeric"
    aria-label="{{ 'products.product.quantity.label' | t }}"
    data-quantity-field
  >
  <button type="button" class="quantity-input__button" data-quantity-increase aria-label="{{ 'products.product.quantity.increase' | t }}">
    {% render 'icon', icon: 'plus' %}
  </button>
</div>
