<div class="customer-section color-scheme-1 section-padding">
  <div class="page-width">
    <div class="account-header">
      <h1 class="account-header__title">{{ 'customer.account.title' | t }}</h1>
      {%- form 'customer_logout' -%}
        <button type="submit" class="button button--secondary">Çıkış Yap</button>
      {%- endform -%}
    </div>

    <div class="account-layout">
      <div class="account-layout__orders">
        <h2>{{ 'customer.orders.title' | t }}</h2>
        {%- if customer.orders.size > 0 -%}
          <table class="account-orders-table">
            <thead>
              <tr>
                <th>{{ 'customer.orders.order_number' | t }}</th>
                <th>{{ 'customer.orders.date' | t }}</th>
                <th>{{ 'customer.orders.payment_status' | t }}</th>
                <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
                <th>{{ 'customer.orders.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                  <td>{{ order.created_at | date: '%d.%m.%Y' }}</td>
                  <td>{{ order.financial_status_label }}</td>
                  <td>{{ order.fulfillment_status_label }}</td>
                  <td>{{ order.total_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}
          <p>{{ 'customer.orders.none' | t }}</p>
        {%- endif -%}
      </div>

      <div class="account-layout__addresses">
        <h2>{{ 'customer.account.details' | t }}</h2>
        <p>{{ customer.name }}<br>{{ customer.email }}</p>
        <a href="{{ routes.account_addresses_url }}" class="button button--secondary">{{ 'customer.account.view_addresses' | t }}</a>
      </div>
    </div>
  </div>
</div>
