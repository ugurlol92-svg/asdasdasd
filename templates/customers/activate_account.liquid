<div class="customer-section color-scheme-1 section-padding">
  <div class="page-width page-width--narrow customer-form">
    <h1 class="customer-form__title">Hesabınızı Aktifleştirin</h1>
    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}
        <div class="form__message form__message--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="customer-form__row">
        <label for="ActivatePassword">Şifre</label>
        <input type="password" name="customer[password]" id="ActivatePassword" required>
      </div>
      <div class="customer-form__row">
        <label for="ActivatePasswordConfirm">Şifreyi Onayla</label>
        <input type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirm" required>
      </div>
      <button type="submit" class="button button--primary button--full">Hesabı Aktifleştir</button>
      <button type="submit" name="decline" class="button button--secondary button--full">Daveti Reddet</button>
    {%- endform -%}
  </div>
</div>
