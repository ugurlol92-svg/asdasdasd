<div class="customer-section color-scheme-1 section-padding">
  <div class="page-width page-width--narrow">
    <a href="{{ routes.account_url }}" class="account-order__back">{% render 'icon', icon: 'chevron-left' %} {{ 'customer.account.return' | t }}</a>
    <h1>{{ 'customer.orders.order_number' | t }} {{ order.name }}</h1>
    <p>{{ order.created_at | date: '%d %B %Y' }}</p>

    <table class="account-orders-table">
      <thead>
        <tr>
          <th>{{ 'cart.general.headings.product' | t }}</th>
          <th>{{ 'cart.general.headings.price' | t }}</th>
          <th>{{ 'cart.general.headings.quantity' | t }}</th>
          <th>{{ 'cart.general.headings.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>{{ line_item.title }}</td>
            <td>{{ line_item.price | money }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>

    <div class="account-order__summary">
      <p>{{ 'cart.general.subtotal' | t }}: {{ order.subtotal_price | money }}</p>
      <p><strong>{{ 'cart.general.headings.total' | t }}: {{ order.total_price | money }}</strong></p>
    </div>

    <div class="account-order__address">
      <h2>Teslimat Adresi</h2>
      {{ order.shipping_address | format_address }}
    </div>
  </div>
</div>
