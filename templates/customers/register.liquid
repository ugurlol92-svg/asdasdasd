<div class="customer-section color-scheme-1 section-padding">
  <div class="page-width page-width--narrow customer-form">
    <h1 class="customer-form__title">{{ 'customer.register.title' | t }}</h1>

    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <div class="form__message form__message--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="customer-form__row-group">
        <div class="customer-form__row">
          <label for="FirstName">{{ 'customer.register.first_name' | t }}</label>
          <input type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name">
        </div>
        <div class="customer-form__row">
          <label for="LastName">{{ 'customer.register.last_name' | t }}</label>
          <input type="text" name="customer[last_name]" id="LastName" autocomplete="family-name">
        </div>
      </div>
      <div class="customer-form__row">
        <label for="Email">{{ 'customer.register.email' | t }}</label>
        <input type="email" name="customer[email]" id="Email" autocomplete="email" required>
      </div>
      <div class="customer-form__row">
        <label for="Password">{{ 'customer.register.password' | t }}</label>
        <input type="password" name="customer[password]" id="Password" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button button--primary button--full">{{ 'customer.register.submit' | t }}</button>
    {%- endform -%}

    <p class="customer-form__hint">
      Zaten hesabınız var mı? <a href="{{ routes.account_login_url }}">{{ 'customer.login_page.sign_in' | t }}</a>
    </p>
  </div>
</div>
