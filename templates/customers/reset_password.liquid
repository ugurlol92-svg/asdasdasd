<div class="customer-section color-scheme-1 section-padding">
  <div class="page-width page-width--narrow customer-form">
    <h1 class="customer-form__title">Yeni Şifre Belirle</h1>
    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <div class="form__message form__message--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="customer-form__row">
        <label for="ResetPassword">Yeni Şifre</label>
        <input type="password" name="customer[password]" id="ResetPassword" required>
      </div>
      <div class="customer-form__row">
        <label for="ResetPasswordConfirm">Şifreyi Onayla</label>
        <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirm" required>
      </div>
      <button type="submit" class="button button--primary button--full">Şifreyi Kaydet</button>
    {%- endform -%}
  </div>
</div>
