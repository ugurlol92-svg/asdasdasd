{
  "sections": {
    "slideshow": {
      "type": "slideshow",
      "settings": {
        "height": "large",
        "overlay_opacity": 20,
        "autoplay": true,
        "change_speed": 6
      },
      "blocks": {
        "slide-1": {
          "type": "slide",
          "settings": {
            "color_scheme": "scheme-1",
            "text_position": "left",
            "subheading": "Yeni Sezon",
            "heading": "Cildinizin İhtiyacı Olan Bakım",
            "text": "<p>%100 doğal içeriklerle üretilen Bayramov Cosmetics ürünlerini keşfedin.</p>",
            "button_label": "Şimdi Keşfet",
            "button_link": "shopify://collections/all",
            "button_style": "primary"
          }
        },
        "slide-2": {
          "type": "slide",
          "settings": {
            "color_scheme": "scheme-4",
            "text_position": "center",
            "subheading": "Sınırlı Süre",
            "heading": "Cilt Bakım Setlerinde %20 İndirim",
            "text": "<p>Doğal ve etkili formüllerle tanışın.</p>",
            "button_label": "Fırsatları Gör",
            "button_link": "shopify://collections/all",
            "button_style": "secondary"
          }
        }
      },
      "block_order": ["slide-1", "slide-2"]
    },
    "multicolumn": {
      "type": "multicolumn",
      "blocks": {
        "item-1": { "type": "item", "settings": { "icon": "truck", "heading": "Ücretsiz Kargo", "text": "<p>500 TL üzeri siparişlerde</p>" } },
        "item-2": { "type": "item", "settings": { "icon": "shield", "heading": "Güvenli Ödeme", "text": "<p>256-bit SSL koruması</p>" } },
        "item-3": { "type": "item", "settings": { "icon": "leaf", "heading": "%100 Doğal İçerik", "text": "<p>Dermatolojik test edilmiştir</p>" } },
        "item-4": { "type": "item", "settings": { "icon": "gift", "heading": "Kolay İade", "text": "<p>14 gün içinde ücretsiz iade</p>" } }
      },
      "block_order": ["item-1", "item-2", "item-3", "item-4"],
      "settings": {
        "heading": "",
        "columns_desktop": "4",
        "color_scheme": "scheme-2"
      }
    },
    "collection-list": {
      "type": "collection-list",
      "blocks": {
        "col-1": { "type": "collection", "settings": { "title": "Cilt Bakımı" } },
        "col-2": { "type": "collection", "settings": { "title": "Makyaj" } },
        "col-3": { "type": "collection", "settings": { "title": "Saç Bakımı" } },
        "col-4": { "type": "collection", "settings": { "title": "Parfüm" } },
        "col-5": { "type": "collection", "settings": { "title": "Setler" } }
