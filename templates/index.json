      "block_order": ["col-1", "col-2", "col-3", "col-4", "col-5"],
      "settings": {
        "heading": "Kategorilere Göre Alışveriş",
        "heading_alignment": "center",
        "columns_desktop": "5",
        "color_scheme": "scheme-1"
      }
    },
    "featured-collection": {
      "type": "featured-collection",
      "settings": {
        "subheading": "Bayramov Cosmetics",
        "heading": "Çok Satanlar",
        "heading_alignment": "left",
        "products_to_show": 8,
        "columns_desktop": "4",
        "show_view_all": true,
        "color_scheme": "scheme-1"
      }
    },
    "image-with-text": {
      "type": "image-with-text",
