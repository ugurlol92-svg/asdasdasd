      "block_order": ["t-1", "t-2", "t-3"],
      "settings": {
        "subheading": "Müşterilerimiz Ne Diyor",
        "heading": "Binlerce Mutlu Müşteri",
        "color_scheme": "scheme-2"
      }
    },
    "brand-logos": {
