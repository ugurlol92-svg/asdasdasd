{
  "sections": {
    "main": {
      "type": "main-product",
      "settings": {
        "show_breadcrumbs": true,
        "color_scheme": "scheme-1"
      },
      "blocks": {
        "title": { "type": "title", "settings": { "show_vendor": true } },
        "price": { "type": "price", "settings": {} },
        "variant_picker": { "type": "variant_picker", "settings": {} },
        "quantity_selector": { "type": "quantity_selector", "settings": {} },
        "buy_buttons": { "type": "buy_buttons", "settings": { "show_dynamic_checkout": true } },
        "description": { "type": "description", "settings": {} },
        "accordion-1": { "type": "accordion", "settings": { "heading": "Kullanım Şekli", "content": "<p>Temiz cilde uygulayın ve nazikçe masaj yapın.</p>", "open_by_default": false } },
        "accordion-2": { "type": "accordion", "settings": { "heading": "İçindekiler", "content": "<p>Ürün içeriği için ambalaj üzerindeki bilgileri inceleyiniz.</p>", "open_by_default": false } },
        "accordion-3": { "type": "accordion", "settings": { "heading": "Kargo ve İade", "content": "<p>500 TL üzeri siparişlerde kargo ücretsizdir. 14 gün içinde ücretsiz iade hakkınız bulunmaktadır.</p>", "open_by_default": false } },
        "share": { "type": "share", "settings": {} }
      },
      "block_order": ["title", "price", "variant_picker", "quantity_selector", "buy_buttons", "description", "accordion-1", "accordion-2", "accordion-3", "share"]
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Bunları da Beğenebilirsiniz",
        "heading_alignment": "center",
        "products_to_show": 4,
        "columns_desktop": "4",
        "color_scheme": "scheme-2"
      }
    }
  },
  "order": ["main", "related-products"]
}
